# ZMODEM wire-capture fixtures and their payload inputs are binary —
# they contain raw protocol bytes with specific line endings that must
# survive a Windows checkout unchanged.  Without this, git's autocrlf
# normalizes LF → CRLF inside the payload files, and the Windows CI job
# fails the `test_lrzsz_replay_*` and `test_upload_save_integration_*`
# tests with a CRLF-in-left / LF-in-right assertion mismatch.
tests/fixtures/*.bin       binary
tests/fixtures/*.payload   binary

# EGT8080.COM is a compiled CP/M binary that is committed and then compiled
# into the gateway with include_bytes!.  Git's content detection already
# treats it as binary (it is full of NULs), but say so explicitly: the exact
# bytes are the product here, and the only thing standing between a checkout
# that normalized them and a shipped-broken terminal is one hash-pin test.
#
# This path is the one thing here that a rename can silently break: a stale
# path matches nothing and fails no test, so the pin quietly stops applying.
# It was stale between the 0.9.2 folder rename and this line -- caught by
# reading, not by CI.
EGT8080/EGT8080.COM        binary

# repodisks.txt is compiled in with include_str! and its *shape* is the
# product: four line feeds before a collection, two between disks.  A Windows
# checkout with autocrlf would rewrite every one of those runs and fail
# `test_the_disk_catalogue_has_the_shape_it_promises` on that platform alone —
# the same class of trap as the fixtures above, found before it bit rather
# than after.  Pinned to LF, and `test_the_catalogue_ships_with_unix_line_endings`
# fails loudly if it ever arrives otherwise.
src/cpm/repodisks.txt      text eol=lf

# The disk manifest is compiled in with include_str! and is TAB-separated —
# a Windows checkout that rewrote its line endings would not break the parse,
# but the file is generated and diffed like repodisks.txt, so pin it the same
# way and keep the two consistent.
src/cpm/altairduino.txt    text eol=lf
