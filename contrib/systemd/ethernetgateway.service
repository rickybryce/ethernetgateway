; systemd service unit for ethernetgateway.
;
; Copy to /etc/systemd/system/ethernetgateway.service (or
; /usr/lib/systemd/system/ for distro packaging), edit User/Group and
; WorkingDirectory below, then:
;
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now ethernetgateway.service
;
; Check status:     systemctl status ethernetgateway
; Live logs:        journalctl -u ethernetgateway -f
; Graceful reload:  systemctl reload ethernetgateway  (SIGHUP)
; Stop:             systemctl stop ethernetgateway

[Unit]
Description=Ethernet Gateway — telnet/SSH/Hayes gateway for retro terminals
Documentation=https://github.com/rickybryce/ethernetgateway
After=network-online.target
Wants=network-online.target

; ── Restart limit ─────────────────────────────────────────
; These two belong to [Unit].  Put under [Service] -- where they read more
; naturally, beside Restart= -- systemd ignores them without a word, and a
; crash loop restarts for ever.  Five starts in sixty seconds, then give up.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple

; ── Identity ──────────────────────────────────────────────
; Create a dedicated service user first:
;   sudo useradd --system --home-dir /var/lib/ethernetgateway \
;                --shell /usr/sbin/nologin ethernetgateway
; Then the directory and its contents belong to that user.
User=ethernetgateway
Group=ethernetgateway

; Serial ports are root:dialout on Linux, so the service account needs that
; group to open /dev/ttyUSB0 and friends.  This is the access control the
; PrivateDevices= note below points at; without it the modem port fails to
; open even with a private /dev turned off.
;   sudo usermod -aG dialout ethernetgateway
SupplementaryGroups=dialout

; ── Paths ─────────────────────────────────────────────────
; WorkingDirectory is where the gateway creates its `ethernetgateway-data`
; folder, and everything it maintains lives inside that: egateway.conf,
; gateway_hosts, the SSH host/client keys, the log and the transfer dir.
; It should be owned by the service user with mode 0750 or tighter.
WorkingDirectory=/var/lib/ethernetgateway
ExecStart=/usr/local/bin/ethernetgateway

; Reload semantics: the binary handles SIGHUP as a config reload — it
; re-reads ethernetgateway-data/egateway.conf and restarts its listeners.
; Active sessions are
; ended (with a goodbye broadcast), so this is a brief bounce rather than a
; zero-downtime reload, but the service stays up on fresh config.
ExecReload=/bin/kill -HUP $MAINPID

; ── One gateway per directory ─────────────────────────────
; The gateway claims WorkingDirectory with an OS-level lock, so a second copy
; started from the SAME directory never reaches a bind.  What it does next
; depends on whether it has a window:
;
;   * Headless (enable_console = false, as a service should be): it refuses and
;     exits 1, naming the process id that holds the ports.  Under the policy
;     below that is 5 retries over 60 s and then a failed unit -- which is the
;     intended outcome, not a bug: it must never stop a working gateway on the
;     strength of a start nobody asked for.
;   * With a window: it OFFERS the operator "Take Over".  If they accept, THIS
;     service stands down through its own shutdown path and exits 0 -- so
;     Restart=on-failure will not bring it back, and `systemctl status` shows it
;     inactive while an unmanaged copy holds the ports.  `systemctl start` then
;     lands on the headless refusal above until that copy is stopped.
;     (With Restart=always instead, systemd WOULD bring it straight back into
;     that refusal and retry until the start limit -- another reason the policy
;     below is on-failure.)
;
; A copy started from a DIFFERENT directory is a separate installation with its
; own lock: it comes up, binds nothing (the ports are taken), and says so in its
; own log and in a banner across its window.  That is the one case the lock
; cannot catch, so the warning is what carries it.

; ── Restart policy ────────────────────────────────────────
; NOTE: the start-limit pair lives in [Unit] above, not here.  systemd silently
; ignores StartLimitIntervalSec= / StartLimitBurst= under [Service], so for two
; releases this block read as though it had a policy and had none at all.
; Measured while installing the unit on a Pi, 2026-09-14.
Restart=on-failure
RestartSec=5s

; ── Hardening ─────────────────────────────────────────────
; All of these are defensive; remove any that break your deployment.
NoNewPrivileges=yes
PrivateTmp=yes
; PrivateDevices=yes gives a private /dev holding pseudo devices only, so
; /dev/ttyUSB0 simply does not exist inside it and the Hayes modem port fails
; to open with no obvious cause.  A DeviceAllow= allowlist is not the fix
; either: a cgroup device policy does not hide nodes, so the port picker would
; still list a port that then fails with EPERM at the moment of use -- a
; silent failure at the worst moment.  Ordinary Unix permissions plus the
; `dialout` group below are the right control; the serial nodes are
; root:dialout.  Set this to `yes` only on a deployment with no serial ports.
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
; AF_NETLINK is not optional: `getifaddrs()` enumerates interfaces over a
; NETLINK_ROUTE socket, so without it the gateway sees only 127.0.0.1 and its
; startup port check reports that the machine has no address of its own and
; skips.  Measured by comparing the app log across a desktop run (found the
; LAN address) and a service run (did not).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

; Allow writing only to the working directory (the gateway creates
; ethernetgateway-data inside it, holding the config, the transfer dir and
; the SSH keys).  Everything else is read-only.
ReadWritePaths=/var/lib/ethernetgateway

; Allow binding low ports (telnet 23 / SSH 22) if the operator chose
; those.  If you stick to the defaults (telnet 2323, SSH 2222) you can
; remove this and tighten further.
; AmbientCapabilities=CAP_NET_BIND_SERVICE
; CapabilityBoundingSet=CAP_NET_BIND_SERVICE

; ── Resource limits ───────────────────────────────────────
; Prevent a runaway connection storm from taking down the host.
LimitNOFILE=8192
TasksMax=256
MemoryMax=512M

; ── Environment ───────────────────────────────────────────
; The gateway reads config from the working directory by default.
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=multi-user.target
